DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_satusurvey
DB_USER=postgres
DB_PASSWORD=root

SECRET_KEY=your_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser origins allowed to call this API (comma separated)
CORS_ORIGINS=https://n3level.id/

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_secret
MINIO_BUCKET=satusurvey
MINIO_SECURE=false

# LLM (OpenAI-compatible; contoh: 9router)
QWEN_API_KEY=YOUR_API_KEY
QWEN_BASE_URL=http://YOUR_9ROUTER_HOST:20128/v1
QWEN_MODEL=alims-intl/qwen-flash
# Model cadangan, dicoba berurutan saat model utama error/kuota habis (pisahkan dengan koma)
LLM_FALLBACK_MODELS=oc/deepseek-v4.1-flash-free,bzl/auto:free,kgw/kilo-auto/free,all
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=0

# Kontrol biaya token
LLM_CLAIM_EXTRACTION=true
LLM_EVALUATION=true
LLM_CLAIM_TEXT_MAX_CHARS=8000
LLM_MAX_EVIDENCE_PER_CLAIM=12
LLM_EVIDENCE_EXCERPT_MAX_CHARS=220

# Antrean analisis (PostgreSQL, tanpa Redis)
ANALYSIS_QUEUE_ENABLED=true
ANALYSIS_WORKER_POLL_SECONDS=2
ANALYSIS_JOB_MAX_ATTEMPTS=2

# Base URL publik untuk share link (opsional; kosongkan agar frontend menyusun URL)
# Proxy LLM terautentikasi ke 9router privat (localhost)
LLM_PROXY_ENABLED=true

SHARE_BASE_URL=

# Upload
MAX_UPLOAD_SIZE_MB=20