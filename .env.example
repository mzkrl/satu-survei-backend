LLM_MODEL=
LLM_TIMEOUT_S=90
PIPELINE_MAX_RETRIES=2
PIPELINE_TOTAL_BUDGET_S=240
THROTTLE_UPLOAD_RATE=10/min

# QWEN CLOUD INFERENCE (satu-satunya provider, OpenAI-compatible)
