SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://user:password@host:5432/satusurvey

S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

REDIS_URL=
# contoh produksi (pakai DB terpisah agar tidak bentrok dengan aplikasi lain):
# REDIS_URL=redis://127.0.0.1:6379/1

LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_S=90
PIPELINE_MAX_RETRIES=2
PIPELINE_TOTAL_BUDGET_S=240
THROTTLE_UPLOAD_RATE=10/min

MAX_UPLOAD_MB=15
MAX_PAGES=60
MAX_TEXT_CHARS=150000
MIN_CHARS_PER_PAGE=200
GROUNDING_MIN_RATIO=0.6
DEMO_MODE=0

# Inspeksi profil (plan2.md, M13+): web search untuk riset
SEARCH_PROVIDER=ninerouter   # ninerouter | tavily | none
TAVILY_API_KEY=              # hanya untuk provider=tavily (langsung)
RESEARCH_ENABLED=1
RESEARCH_MODEL_A=bzl/deepseek-v4-flash-0731free
RESEARCH_MODEL_B=oc/glm-5.3-flash-free
SYNTH_MODEL=bzl/auto:free
RESEARCH_BUDGET_S=180
RESEARCH_MAX_TARGETS=3
SEARCH_MAX_QUERIES=12
SEARCH_RESULTS_PER_QUERY=3
SEARCH_TIMEOUT_S=10
WEBFETCH_ENABLED=0
SEARCH_MODELS=tavily,exa,searxng        # urutan fallback per query; searxng direct (lihat SEARXNG_URL)
EXA_API_KEY=                       # hanya untuk fallback langsung (api.exa.ai)
SEARXNG_URL=                          # direct, tanpa9router; di VPS compose bisa http://127.0.0.1:8888
